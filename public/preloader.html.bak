<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Velovalue Preloader Test</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <style>
    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      font-family: 'Inter', sans-serif;
      background: #000;
      color: #fff;
      overflow: hidden;
    }

    /* Preloader full screen */
    #preloader {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #000;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      font-size: 4rem;
    }

    .preloader-text {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    /* Header logo at top center */
    #main-header {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 2rem;
      opacity: 0;
      transition: opacity 1s ease;
      color: #fff;
      z-index: 100;
    }

    main {
      padding: 100px 20px 20px;
      color: #fff;
    }
  </style>
</head>
<body>
  <!-- Preloader -->
  <div id="preloader">
    <div class="preloader-text" id="text">Hello</div>
  </div>

  <!-- Header logo -->
  <header id="main-header">
    Velovalue
  </header>

  <!-- Main content -->
  <main>
    <h2>Homepage Content Here</h2>
    <p>Test your homepage content after preloader.</p>
  </main>

  <script>
    const texts = ["Hello", "Ciao", "Velovalue"];
    const textElement = document.getElementById("text");
    const preloader = document.getElementById("preloader");
    const header = document.getElementById("main-header");

    let index = 1; // skip first Hello since it's already in HTML

    function showNextText() {
      if (index < texts.length) {
        textElement.style.opacity = 0;
        setTimeout(() => {
          textElement.innerText = texts[index];
          textElement.style.opacity = 1;
          textElement.style.transform = "translateY(0)";
          index++;
          setTimeout(showNextText, 1000);
        }, 500);
      } else {
        // Move Velovalue to top center
        const headerRect = header.getBoundingClientRect();
        const textRect = textElement.getBoundingClientRect();
        const x = headerRect.left + headerRect.width/2 - (textRect.left + textRect.width/2);
        const y = headerRect.top + headerRect.height/2 - (textRect.top + textRect.height/2);

        textElement.style.transition = "all 1s ease";
        textElement.style.transform = `translate(${x}px, ${y}px) scale(0.5)`;
        textElement.style.opacity = 0.7;

        setTimeout(() => {
          preloader.style.display = "none";
          header.style.opacity = 1;
          document.body.style.overflow = "auto";
        }, 1000);
      }
    }

    window.addEventListener("load", () => {
      textElement.style.opacity = 1;
      textElement.style.transform = "translateY(0)";
      setTimeout(showNextText, 1000);
    });
  </script>
</body>
</html>
