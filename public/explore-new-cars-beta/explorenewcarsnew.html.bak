<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VeloValue – Explore Electric Cars</title>
  <!-- Tailwind CSS via CDN (v4 browser build) -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <style>
    :root {
      color-scheme: dark;
      --bg-body: #020617;
      --bg-panel: #020617;
      --bg-panel-soft: #020617;
      --border-subtle: rgba(148, 163, 184, 0.35);
      --accent: #22c55e;
      --accent-soft: rgba(34, 197, 94, 0.1);
      --danger: #f97373;
      --danger-soft: rgba(239, 68, 68, 0.1);
      --header-height: 64px;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", sans-serif;
      background: radial-gradient(circle at top left, #0f172a, #020617 56%, #000 100%);
      color: #e5e7eb;
      min-height: 100vh;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font-family: inherit;
    }

    img {
      max-width: 100%;
      display: block;
    }

    main {
      width: 100%;
    }

    /* Header */
    header {
      position: sticky;
      top: 0;
      z-index: 40;
      backdrop-filter: blur(16px);
      background: linear-gradient(90deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.94));
      border-bottom: 1px solid rgba(148, 163, 184, 0.4);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.4rem 1.5rem;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 0.9rem;
    }

    .header-left h1 {
      font-size: 1.15rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .header-left h1 a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-weight: 700;
      color: #e5e7eb;
    }

    .header-left h1 a::before {
      content: "";
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: radial-gradient(circle at 30% 20%, #bbf7d0, #22c55e 55%, #166534 100%);
      box-shadow: 0 0 18px rgba(34, 197, 94, 0.9);
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      font-size: 0.78rem;
      letter-spacing: 0.16em;
    }

    .desktop-nav a {
      padding: 0.35rem 0;
      color: #cbd5f5;
      position: relative;
      text-transform: uppercase;
    }

    .desktop-nav a::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: -0.2rem;
      height: 2px;
      border-radius: 999px;
      transform: scaleX(0);
      transform-origin: 0 50%;
      background: linear-gradient(90deg, #22c55e, #2dd4bf);
      transition: transform 0.16s ease-out;
    }

    .desktop-nav a:hover::after,
    .desktop-nav a:focus-visible::after {
      transform: scaleX(1);
    }

    .hamburger {
      border-radius: 999px;
      width: 32px;
      height: 32px;
      border: 1px solid rgba(148, 163, 184, 0.65);
      background: radial-gradient(circle at 30% 10%, #0f172a, #020617);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #e5e7eb;
      cursor: pointer;
      font-size: 1.1rem;
    }

    .hamburger:hover {
      border-color: #22c55e;
      box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.65);
    }

    .language-select select {
      background: transparent;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.65);
      color: #e5e7eb;
      font-size: 0.78rem;
      padding: 0.25rem 1.75rem 0.25rem 0.5rem;
      appearance: none;
      position: relative;
      background-image:
        linear-gradient(45deg, transparent 50%, #94a3b8 50%),
        linear-gradient(135deg, #94a3b8 50%, transparent 50%);
      background-position:
        calc(100% - 12px) calc(50% - 3px),
        calc(100% - 6px) calc(50% - 3px);
      background-size: 6px 6px, 6px 6px;
      background-repeat: no-repeat;
    }

    .language-select select:focus-visible {
      outline: 2px solid #22c55e;
      outline-offset: 2px;
    }

    .icon-btn {
      width: 34px;
      height: 34px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: radial-gradient(circle at 30% 10%, #020617, #020617);
      color: #e5e7eb;
      display: grid;
      place-items: center;
      cursor: pointer;
      position: relative;
      padding: 0;
    }

    .icon-btn svg {
      width: 18px;
      height: 18px;
    }

    .icon-btn:hover {
      border-color: #22c55e;
      box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.6);
    }

    .text-btn {
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.6);
      background: rgba(15, 23, 42, 0.6);
      color: #e5e7eb;
      font-size: 0.8rem;
      padding: 0.35rem 0.85rem;
      cursor: pointer;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .text-btn:hover {
      border-color: #22c55e;
      background: radial-gradient(circle at top left, rgba(34, 197, 94, 0.18), rgba(15, 23, 42, 0.9));
    }

    .badge {
      position: absolute;
      top: -4px;
      right: -4px;
      min-width: 17px;
      height: 17px;
      padding: 0 3px;
      border-radius: 999px;
      background: linear-gradient(120deg, #22c55e, #2dd4bf);
      color: #020617;
      font-size: 0.6rem;
      display: none;
      align-items: center;
      justify-content: center;
      font-weight: 700;
    }

    .wishlist,
    .compare {
      position: relative;
    }

    .dropdown {
      position: absolute;
      right: 0;
      top: 130%;
      background: rgba(15, 23, 42, 0.98);
      border-radius: 0.75rem;
      border: 1px solid rgba(148, 163, 184, 0.5);
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.85);
      min-width: 260px;
      max-width: 320px;
      max-height: 380px;
      display: none;
      overflow: hidden;
    }

    .wishlist.open .dropdown,
    #compare.open .dropdown {
      display: block;
    }

    .dropdown-head {
      padding: 0.65rem 0.85rem;
      border-bottom: 1px solid rgba(148, 163, 184, 0.4);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.82rem;
      background: radial-gradient(circle at top left, rgba(34, 197, 94, 0.14), rgba(15, 23, 42, 0.96));
    }

    .dropdown-list {
      max-height: 260px;
      overflow: auto;
    }

    .wish-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.85rem;
      font-size: 0.8rem;
      cursor: pointer;
    }

    .wish-item img {
      width: 48px;
      height: 48px;
      border-radius: 0.6rem;
      object-fit: cover;
    }

    .wish-item:hover {
      background: rgba(15, 23, 42, 0.9);
    }

    .wish-meta {
      flex: 1;
      min-width: 0;
    }

    .wish-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .wish-sub {
      font-size: 0.7rem;
      opacity: 0.75;
    }

    .remove-btn {
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.5);
      background: transparent;
      color: #e5e7eb;
      font-size: 0.7rem;
      padding: 0.15rem 0.55rem;
      cursor: pointer;
    }

    .remove-btn:hover {
      border-color: #f97316;
      color: #fed7aa;
    }

    /* Mobile / desktop nav */
    @media (max-width: 900px) {
      .desktop-nav {
        display: none;
      }
    }

    @media (min-width: 901px) {
      .hamburger {
        display: none;
      }
    }

    /* Slide-in mobile menu & overlay */
    .menu {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 260px;
      background: radial-gradient(circle at top left, #020617, #020617 55%, #000 100%);
      border-right: 1px solid rgba(148, 163, 184, 0.4);
      transform: translateX(-100%);
      transition: transform 0.22s ease-out;
      z-index: 35;
      padding-top: 4.4rem;
      padding-inline: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .menu a {
      font-size: 0.86rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 0.5rem 0.2rem;
      border-bottom: 1px solid rgba(30, 64, 175, 0.3);
      color: #e2e8f0;
    }

    .menu.active {
      transform: translateX(0);
    }

    .menu-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.7);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.18s ease-out;
      z-index: 30;
    }

    .menu-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    /* Hero */
    .hero {
      position: relative;
      overflow: hidden;
      border-bottom: 1px solid rgba(30, 64, 175, 0.4);
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
      isolation: isolate;
    }

    .hero video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: saturate(1.2) contrast(1.05) brightness(0.65);
      transform: scale(1.03);
      z-index: -2;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        radial-gradient(circle at top left, rgba(34, 197, 94, 0.35), transparent 55%),
        linear-gradient(to top, rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.25));
      z-index: -1;
    }

    .search-wrap {
      width: min(760px, 94vw);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.9rem;
      padding: 1.9rem 1.6rem;
      border-radius: 1.2rem;
      border: 1px solid rgba(148, 163, 184, 0.5);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.94));
      box-shadow:
        0 35px 80px rgba(0, 0, 0, 0.9),
        0 0 0 1px rgba(15, 23, 42, 0.9);
    }

    .search-wrap::before {
      content: "Find your next EV";
      font-size: 0.78rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #9ca3af;
    }

    .search-row {
      display: flex;
      gap: 0.6rem;
      margin-top: 0.25rem;
    }

    .search-row input[type="text"] {
      flex: 1;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.75);
      padding: 0.6rem 0.9rem;
      font-size: 0.9rem;
      background: radial-gradient(circle at top left, #020617, #020617);
      color: #e5e7eb;
    }

    .search-row input::placeholder {
      color: #64748b;
    }

    .search-btn {
      border-radius: 999px;
      border: none;
      padding: 0.6rem 1.4rem;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      background: linear-gradient(120deg, #22c55e, #22c55e);
      color: #020617;
      cursor: pointer;
      white-space: nowrap;
      box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.4), 0 10px 25px rgba(22, 163, 74, 0.7);
    }

    .search-btn:hover {
      filter: brightness(1.03);
      transform: translateY(-0.5px);
    }

    .search-hint {
      font-size: 0.75rem;
      opacity: 0.7;
    }

    @media (max-width: 640px) {
      .search-row {
        flex-direction: column;
      }

      .search-btn {
        width: 100%;
      }
    }

    /* Sections */
    .section {
      padding: 1.75rem min(5vw, 2.2rem);
    }

    .section h2 {
      font-size: 1.05rem;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: #9ca3af;
      margin-bottom: 0.85rem;
    }

    /* Popular marquee */
    .marquee {
      position: relative;
      overflow: hidden;
      border-radius: 1rem;
      border: 1px solid rgba(30, 64, 175, 0.52);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.94));
    }

    .track {
      display: flex;
      gap: 0.8rem;
      padding: 0.75rem 0.85rem;
      width: max-content;
      animation: marquee 32s linear infinite;
    }

    .marquee:hover .track {
      animation-play-state: paused;
    }

    @keyframes marquee {
      0% {
        transform: translateX(0);
      }

      100% {
        transform: translateX(-50%);
      }
    }

    /* Filters + results layout */
    .filters-wrap {
      display: grid;
      grid-template-columns: minmax(0, 240px) minmax(0, 1.6fr) minmax(0, 210px);
      gap: 1rem;
      align-items: flex-start;
    }

    .panel {
      border-radius: 1rem;
      border: 1px solid rgba(51, 65, 85, 0.9);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.98));
      padding: 0.9rem 0.9rem 1rem;
    }

    .left-filters h3,
    .brand-panel h3 {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: #9ca3af;
      margin: 0 0 0.4rem;
    }

    .filters-toggle {
      display: none;
    }

    .f-group {
      margin-top: 0.6rem;
    }

    .f-label {
      display: block;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: #9ca3af;
      margin-bottom: 0.15rem;
    }

    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .chip {
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: rgba(15, 23, 42, 0.9);
      color: #e5e7eb;
      font-size: 0.75rem;
      padding: 0.18rem 0.7rem;
      cursor: pointer;
    }

    .chip.active {
      border-color: #22c55e;
      background: rgba(34, 197, 94, 0.18);
      box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.7);
    }

    .range {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.78rem;
    }

    .range input[type="range"] {
      flex: 1;
    }

    .muted {
      opacity: 0.7;
      font-size: 0.8rem;
    }

    .apply-btn {
      margin-top: 0.7rem;
      width: 100%;
      border-radius: 999px;
      border: none;
      background: linear-gradient(120deg, #22c55e, #22c55e);
      color: #020617;
      padding: 0.5rem 0.9rem;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .apply-btn:hover {
      filter: brightness(1.04);
    }

    /* Toolbar + grid */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.4rem;
    }

    .toolbar .count {
      font-size: 0.85rem;
      color: #d1d5db;
    }

    .toolbar-actions {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .toolbar select {
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: rgba(15, 23, 42, 0.9);
      color: #e5e7eb;
      font-size: 0.8rem;
      padding: 0.23rem 0.7rem;
    }

    .clear-filters {
      border-radius: 999px;
      border: 1px dashed rgba(148, 163, 184, 0.7);
      background: transparent;
      color: #e5e7eb;
      font-size: 0.75rem;
      padding: 0.2rem 0.7rem;
      cursor: pointer;
    }

    .clear-filters:hover {
      border-style: solid;
      border-color: #f97316;
      color: #fed7aa;
    }

    .active-filters {
      margin-bottom: 0.4rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
    }

    .af-chip {
      border-radius: 999px;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(148, 163, 184, 0.7);
      font-size: 0.72rem;
      padding: 0.12rem 0.55rem 0.12rem 0.7rem;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
    }

    .af-chip .x {
      border: none;
      background: transparent;
      color: #9ca3af;
      cursor: pointer;
      font-size: 0.9em;
      padding: 0;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 0.8rem;
      margin-top: 0.5rem;
    }

    .car-card {
      position: relative;
      border-radius: 0.9rem;
      border: 1px solid rgba(51, 65, 85, 0.92);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.98));
      overflow: hidden;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .car-card.compact {
      width: 240px;
      min-width: 220px;
    }

    .car-card .thumb {
      width: 100%;
      height: 130px;
      object-fit: cover;
    }

    .car-card .meta {
      padding: 0.55rem 0.7rem 0.6rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      font-size: 0.8rem;
    }

    .car-card .name {
      font-weight: 600;
      margin-bottom: 0.12rem;
    }

    .pill {
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      padding: 0.12rem 0.5rem;
      font-size: 0.72rem;
      white-space: nowrap;
      background: rgba(15, 23, 42, 0.9);
    }

    .heart-btn,
    .compare-btn {
      position: absolute;
      top: 6px;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.75);
      background: rgba(15, 23, 42, 0.88);
      color: #e5e7eb;
      display: grid;
      place-items: center;
      cursor: pointer;
      padding: 0;
    }

    .heart-btn {
      right: 6px;
    }

    .compare-btn {
      left: 6px;
    }

    .compare-btn svg {
      width: 16px;
      height: 16px;
    }

    .heart-btn svg {
      width: 16px;
      height: 16px;
    }

    .heart-btn.active,
    .compare-btn.active {
      border-color: #22c55e;
      background: rgba(34, 197, 94, 0.16);
      box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.65);
    }

    .heart-btn.pop {
      animation: heart-pop 0.28s ease-out;
    }

    @keyframes heart-pop {
      0% {
        transform: scale(1);
      }

      40% {
        transform: scale(1.25);
      }

      100% {
        transform: scale(1);
      }
    }

    /* Brands panel */
    .brand-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .brand-tile {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.3rem 0.4rem;
      border-radius: 0.6rem;
      border: 1px solid rgba(51, 65, 85, 0.95);
      cursor: pointer;
      font-size: 0.8rem;
    }

    .brand-logo {
      width: 24px;
      height: 24px;
      border-radius: 999px;
      background: radial-gradient(circle at top left, #22c55e, #0f172a);
      color: #020617;
      display: grid;
      place-items: center;
      font-size: 0.7rem;
      font-weight: 700;
    }

    .brand-name {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .brand-tile.active {
      border-color: #22c55e;
      background: rgba(34, 197, 94, 0.1);
    }

    .alpha-row {
      margin-top: 0.6rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      font-size: 0.68rem;
      text-transform: uppercase;
    }

    .alpha {
      border-radius: 999px;
      padding: 0.08rem 0.38rem;
      border: 1px solid transparent;
      cursor: pointer;
      color: #9ca3af;
    }

    .alpha.active {
      border-color: #22c55e;
      background: rgba(34, 197, 94, 0.14);
      color: #e5e7eb;
    }

    /* Sticky compare bar */
    .compare-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      transform: translateY(100%);
      transition: transform 0.2s ease-out;
      z-index: 38;
    }

    .compare-bar.show {
      transform: translateY(0);
    }

    .compare-bar .row {
      max-width: 1040px;
      margin: 0 auto 0.75rem;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.75);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.97));
      padding: 0.45rem 0.8rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      font-size: 0.8rem;
    }

    .compare-bar .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem;
    }

    .compare-bar .chip {
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.75);
      padding: 0.12rem 0.55rem 0.12rem 0.7rem;
      font-size: 0.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.18rem;
      background: rgba(15, 23, 42, 0.95);
    }

    .compare-bar .chip .x {
      border: none;
      background: transparent;
      color: #9ca3af;
      cursor: pointer;
      padding: 0;
      font-size: 0.9em;
    }

    .compare-bar .btn {
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.8);
      background: rgba(15, 23, 42, 0.96);
      color: #e5e7eb;
      font-size: 0.75rem;
      padding: 0.25rem 0.7rem;
      cursor: pointer;
    }

    .compare-bar .btn.primary {
      border-color: #22c55e;
      background: linear-gradient(120deg, #22c55e, #22c55e);
      color: #020617;
      font-weight: 600;
    }

    /* Toasts */
    .toast-wrap {
      position: fixed;
      right: 1rem;
      bottom: 4.2rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      z-index: 50;
    }

    .toast {
      background: rgba(15, 23, 42, 0.98);
      border-radius: 0.8rem;
      border: 1px solid rgba(148, 163, 184, 0.8);
      padding: 0.4rem 0.75rem;
      font-size: 0.8rem;
      color: #e5e7eb;
      transform: translateY(8px);
      opacity: 0;
      transition: opacity 0.2s ease-out, transform 0.2s ease-out;
      max-width: 260px;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    .toast.hide {
      opacity: 0;
      transform: translateY(8px);
    }

    /* Compare modal */
    .compare-modal {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.85);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 60;
      padding: 1.5rem 1rem;
    }

    .compare-modal.show {
      display: flex;
    }

    .compare-modal-inner {
      width: min(960px, 100%);
      max-height: 100%;
      border-radius: 1.1rem;
      border: 1px solid rgba(148, 163, 184, 0.9);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.98), rgba(15, 23, 42, 0.98));
      padding: 0.9rem 1.1rem 1rem;
      overflow: auto;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 0.55rem;
      right: 0.6rem;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.7);
      background: rgba(15, 23, 42, 0.95);
      color: #e5e7eb;
      width: 26px;
      height: 26px;
      display: grid;
      place-items: center;
      cursor: pointer;
      font-size: 0.9rem;
    }

    .compare-modal h2 {
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: #e5e7eb;
      margin: 0 0 0.15rem;
    }

    .compare-modal .muted.small {
      font-size: 0.75rem;
      margin-bottom: 0.75rem;
    }

    .compare-modal-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 0.7rem;
      margin-top: 0.2rem;
    }

    .compare-card {
      border-radius: 0.9rem;
      border: 1px solid rgba(51, 65, 85, 0.95);
      background: radial-gradient(circle at top left, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.98));
      overflow: hidden;
      font-size: 0.8rem;
    }

    .compare-card-img {
      width: 100%;
      height: 140px;
      object-fit: cover;
    }

    .compare-card-title {
      font-weight: 600;
      padding: 0.4rem 0.6rem 0.1rem;
    }

    .compare-card-sub {
      padding: 0 0.6rem;
      font-size: 0.76rem;
      opacity: 0.75;
    }

    .compare-card-price {
      padding: 0.35rem 0.6rem 0.55rem;
      font-size: 0.8rem;
      font-weight: 500;
      color: #bbf7d0;
    }

    /* About section */
    #about {
      border-top: 1px solid rgba(30, 64, 175, 0.5);
      margin-top: 1.5rem;
      padding-bottom: 3.5rem;
    }

    #about p {
      max-width: 720px;
      font-size: 0.85rem;
      color: #cbd5f5;
    }

    #about .cols {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 1rem;
      margin-top: 0.7rem;
      font-size: 0.82rem;
    }

    #about ul {
      padding-left: 1.1rem;
      margin: 0.35rem 0 0;
    }

    #about li {
      margin-bottom: 0.18rem;
    }

    footer {
      padding: 0.9rem 1.5rem 1.3rem;
      border-top: 1px solid rgba(30, 64, 175, 0.55);
      font-size: 0.78rem;
      opacity: 0.75;
      text-align: center;
    }

    /* Responsive tweaks */
    @media (max-width: 960px) {
      .filters-wrap {
        grid-template-columns: minmax(0, 1fr);
      }

      .brand-panel {
        order: -1;
      }
    }

    @media (max-width: 720px) {
      .section {
        padding-inline: 1rem;
      }

      .filters-wrap {
        gap: 0.8rem;
      }

      .toolbar {
        flex-direction: column;
        align-items: flex-start;
      }

      #about .cols {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 640px) {
      .filters-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        border: 1px solid rgba(148, 163, 184, 0.7);
        background: rgba(15, 23, 42, 0.9);
        padding: 0.2rem 0.65rem;
        margin-top: 0.35rem;
        font-size: 0.78rem;
        cursor: pointer;
      }

      .left-filters.collapsed #filtersContent {
        display: none;
      }
    }
  </style>
</head>

<body class="bg-slate-950 text-slate-100">
  <!-- Unified Header -->
  <header>
    <div class="header-left">
      <button class="hamburger" aria-label="Toggle menu" aria-expanded="false">☰</button>
      <h1><a href="#home">VeloValue</a></h1>
    </div>

    <div class="header-right">
      <nav class="desktop-nav">
        <a href="#home">Home</a>
        <a href="#filters">Explore Smart Garage</a>
        <a href="#popular">Velocharge</a>
        <a href="#about">About Us</a>
      </nav>

      <div class="language-select">
        <select id="languageSelect" aria-label="Language selector">
          <option value="en">🇬🇧 English</option>
          <option value="it">🇮🇹 Italiano</option>
          <option value="de">🇩🇪 Deutsch</option>
        </select>
      </div>

      <!-- Wishlist dropdown -->
      <div class="wishlist" id="wishlist">
        <button id="wishlistBtn" class="icon-btn" aria-label="Wishlist" aria-expanded="false" aria-controls="wishlistMenu">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.1 8.64l-.1.1-.1-.1c-1.68-1.79-4.53-1.79-6.21 0-1.8 1.92-1.8 5.02 0 6.94L12 22l6.31-6.42c1.8-1.92 1.8-5.02 0-6.94-1.68-1.79-4.53-1.79-6.21 0z" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span class="badge" id="wishlistBadge">0</span>
        </button>
        <div id="wishlistMenu" class="dropdown" role="menu" aria-label="Wishlist">
          <div class="dropdown-head">
            <strong>Wishlist</strong>
            <button id="clearWishlist" class="text-btn" type="button">Clear all</button>
          </div>
          <div id="wishlistItems" class="dropdown-list">
            <div class="dropdown-empty" style="padding:20px; text-align:center; opacity:.75;">Your wishlist is empty.</div>
          </div>
        </div>
      </div>

      <!-- Compare dropdown -->
      <div class="wishlist compare" id="compare">
        <button id="compareBtn" class="icon-btn" aria-label="Compare" aria-expanded="false" aria-controls="compareMenu" title="Compare">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 17h6M3 7h10M3 12h14" stroke="currentColor" stroke-width="1.6" fill="none" />
          </svg>
          <span class="badge" id="compareBadge">0</span>
        </button>
        <div id="compareMenu" class="dropdown" role="menu" aria-label="Compare">
          <div class="dropdown-head">
            <strong>Compare</strong>
            <button id="clearCompare" class="text-btn" type="button">Clear all</button>
          </div>
          <div id="compareItems" class="dropdown-list">
            <div class="dropdown-empty" style="padding:20px; text-align:center; opacity:.75;">Nothing to compare.</div>
          </div>
          <div style="padding:10px; border-top:1px solid rgba(255,255,255,.1); display:flex; justify-content:flex-end;">
            <button id="viewCompare" class="text-btn" type="button">View compare</button>
          </div>
        </div>
      </div>

      <div id="authSection">
        <button class="text-btn" id="loginBtn" type="button">Login / Register</button>
      </div>
    </div>
  </header>

  <!-- Slide-in mobile menu + overlay -->
  <nav class="menu" id="hamburgerMenu" aria-hidden="true">
    <a href="#home">Home</a>
    <a href="#filters">Explore Smart Garage</a>
    <a href="#popular">Discover Velocharge</a>
    <a href="#about">About Us</a>
  </nav>
  <div class="menu-overlay"></div>

  <!-- Hero search -->
  <section class="hero" id="home">
    <video autoplay muted loop playsinline>
      <source src="https://videos.pexels.com/video-files/855332/855332-hd_1280_720_25fps.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>
    <div class="search-wrap">
      <div class="search-row">
        <input id="searchInput" type="text" placeholder="Search by brand, model or body style..." aria-label="Search cars" />
        <button class="search-btn" id="searchBtn" type="button">Search</button>
      </div>
      <div class="search-hint">Tip: Try "Tesla Model 3" or "SUV".</div>
    </div>
  </section>

  <!-- Popular in Italy -->
  <section class="section" id="popular">
    <h2>Popular Cars in Italy</h2>
    <div class="marquee">
      <div class="track" id="popularTrack"></div>
    </div>
  </section>

  <!-- Filters + Results -->
  <section class="section" id="filters">
    <div class="filters-wrap">
      <!-- Left: filters -->
      <aside class="panel left-filters" id="leftFilters">
        <h3>Filter By</h3>
        <button id="filtersToggle" class="filters-toggle" aria-expanded="true" type="button">Filter By</button>
        <div id="filtersContent">
          <div class="f-group">
            <span class="f-label">Body Style</span>
            <div class="chip-row" id="bodyChips"></div>
          </div>
          <div class="f-group">
            <span class="f-label">Fuel</span>
            <div class="chip-row" id="fuelChips"></div>
          </div>
          <div class="f-group">
            <span class="f-label">Transmission</span>
            <div class="chip-row" id="gearChips"></div>
          </div>
          <div class="f-group">
            <span class="f-label">Price (EUR)</span>
            <div class="range">
              <input type="range" id="priceRange" min="20000" max="120000" value="120000" step="1000" />
              <span id="priceOut" class="muted">≤ €120,000</span>
            </div>
          </div>
          <button class="apply-btn" id="applyFilters" type="button">Done</button>
        </div>
      </aside>

      <!-- Center: results grid -->
      <main class="panel results">
        <div class="toolbar">
          <div class="count" id="resultCount" role="status" aria-live="polite">0 results</div>
          <div class="toolbar-actions">
            <label class="sr-only" for="sortSel">Sort</label>
            <select id="sortSel" aria-label="Sort">
              <option value="relevance">Sort: Relevance</option>
              <option value="price_asc">Price: Low → High</option>
              <option value="price_desc">Price: High → Low</option>
              <option value="rating_desc">Rating</option>
            </select>
            <button id="clearFiltersBtn" class="clear-filters" type="button" title="Clear all filters">Clear filters</button>
          </div>
        </div>
        <div id="activeFilters" class="active-filters"></div>
        <div class="grid" id="resultsGrid"></div>
      </main>

      <!-- Right: brand tiles -->
      <aside class="panel brand-panel">
        <h3 style="margin:4px 0 10px">Brands</h3>
        <div class="brand-grid" id="brandGrid"></div>
        <div class="alpha-row" id="alphaRow"></div>
      </aside>
    </div>
  </section>

  <!-- Sticky compare bar -->
  <div id="compareBar" class="compare-bar" aria-live="polite">
    <div class="row">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <strong>Compare</strong>
        <div class="chips" id="compareChips"></div>
      </div>
      <div class="actions" style="display:flex; gap:0.4rem;">
        <button class="btn" id="compareClearBtn" type="button">Clear</button>
        <button class="btn primary" id="compareGoBtn" type="button">Compare Now</button>
      </div>
    </div>
  </div>

  <!-- Toast container -->
  <div id="toastWrap" class="toast-wrap" aria-live="polite" aria-atomic="true"></div>

  <!-- Compare modal -->
  <div id="compareModal" class="compare-modal" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="compare-modal-inner">
      <button id="compareModalClose" class="modal-close" type="button" aria-label="Close">×</button>
      <h2>Compare cars</h2>
      <p class="muted small">Quick, side‑by‑side overview of cars you've added to compare.</p>
      <div id="compareModalGrid" class="compare-modal-grid"></div>
    </div>
  </div>

  <!-- About -->
  <section class="section" id="about">
    <h2>About VeloValue</h2>
    <p>
      VeloValue is a concept experience for exploring and comparing modern electric and electrified cars.
      Filter by body style, fuel type, gearbox and price to quickly narrow in on your next dream EV.
    </p>
    <div class="cols">
      <div>
        <h3 style="font-size:0.85rem; margin:0.3rem 0 0.2rem;">What you can do</h3>
        <ul>
          <li>Browse a curated sample of popular EVs sold in Europe.</li>
          <li>Filter with multi‑select chips and live price range.</li>
          <li>Wishlist favourites to revisit later.</li>
          <li>Compare up to four cars side‑by‑side.</li>
        </ul>
      </div>
      <div>
        <h3 style="font-size:0.85rem; margin:0.3rem 0 0.2rem;">Demo only</h3>
        <p>
          This is a front‑end demo running entirely in a single HTML file. Car data is fetched from your own backend
          that aggregates specifications from Wikipedia; if the backend is unavailable, it falls back to a small static
          demo dataset. Authentication is still simulated.
        </p>
      </div>
    </div>
  </section>

  <footer>
    © <span id="yearSpan"></span> VeloValue. Demo experience only – no real offers.
  </footer>

  <script type="module">
    // === Data ===
    const DEMO_CARS = [
      {
        brand: "Tesla",
        model: "Model 3",
        year: 2024,
        body: "Sedan",
        fuel: "Electric",
        gear: "Auto",
        price: 45500,
        rating: 4.8,
        popularIn: ["IT", "DE", "UK"],
        img: "https://images.pexels.com/photos/799443/pexels-photo-799443.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "Tesla",
        model: "Model Y",
        year: 2024,
        body: "SUV",
        fuel: "Electric",
        gear: "Auto",
        price: 51500,
        rating: 4.7,
        popularIn: ["IT", "DE"],
        img: "https://images.pexels.com/photos/115677/pexels-photo-115677.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "Volkswagen",
        model: "ID.3",
        year: 2023,
        body: "Hatchback",
        fuel: "Electric",
        gear: "Auto",
        price: 38500,
        rating: 4.4,
        popularIn: ["IT", "DE"],
        img: "https://images.pexels.com/photos/210019/pexels-photo-210019.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "Fiat",
        model: "500e",
        year: 2023,
        body: "City car",
        fuel: "Electric",
        gear: "Auto",
        price: 29500,
        rating: 4.3,
        popularIn: ["IT"],
        img: "https://images.pexels.com/photos/799443/pexels-photo-799443.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "BMW",
        model: "i4",
        year: 2024,
        body: "Sedan",
        fuel: "Electric",
        gear: "Auto",
        price: 64900,
        rating: 4.6,
        popularIn: ["DE", "IT"],
        img: "https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "Audi",
        model: "Q4 e-tron",
        year: 2024,
        body: "SUV",
        fuel: "Electric",
        gear: "Auto",
        price: 59500,
        rating: 4.5,
        popularIn: ["IT", "DE", "AT"],
        img: "https://images.pexels.com/photos/210019/pexels-photo-210019.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "Renault",
        model: "Mégane E-Tech",
        year: 2023,
        body: "Hatchback",
        fuel: "Electric",
        gear: "Auto",
        price: 36900,
        rating: 4.2,
        popularIn: ["FR", "IT"],
        img: "https://images.pexels.com/photos/799443/pexels-photo-799443.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "Hyundai",
        model: "Ioniq 5",
        year: 2023,
        body: "Crossover",
        fuel: "Electric",
        gear: "Auto",
        price: 47900,
        rating: 4.6,
        popularIn: ["IT", "DE", "UK"],
        img: "https://images.pexels.com/photos/210019/pexels-photo-210019.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "Polestar",
        model: "2",
        year: 2024,
        body: "Liftback",
        fuel: "Electric",
        gear: "Auto",
        price: 53900,
        rating: 4.5,
        popularIn: ["DE", "SE", "IT"],
        img: "https://images.pexels.com/photos/210019/pexels-photo-210019.jpeg?auto=compress&cs=tinysrgb&w=1200"
      },
      {
        brand: "Mercedes-Benz",
        model: "EQE",
        year: 2024,
        body: "Sedan",
        fuel: "Electric",
        gear: "Auto",
        price: 84900,
        rating: 4.7,
        popularIn: ["DE", "IT"],
        img: "https://images.pexels.com/photos/112460/pexels-photo-112460.jpeg?auto=compress&cs=tinysrgb&w=1200"
      }
    ];

    // === Helpers ===
    const $ = (sel, root = document) => root.querySelector(sel);
    const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
    const toEUR = n => `€${Number(n).toLocaleString("it-IT", { maximumFractionDigits: 0 })}`;
    const parsePrice = v => {
      if (v == null) return 0;
      if (typeof v === "number") return v;
      const digits = String(v).replace(/[^0-9]/g, "");
      return digits ? Number(digits) : 0;
    };
    const debounce = (fn, wait = 280) => {
      let t;
      return (...args) => {
        clearTimeout(t);
        t = setTimeout(() => fn(...args), wait);
      };
    };
    const carId = c => `${c.brand}-${c.model}`.toLowerCase().replace(/[^a-z0-9]+/g, "-");

    let cars = [];
    let carsById = new Map();

    const BACKEND = "http://localhost:3000";

    async function loadCarsFromBackend() {
      let arr = [];
      try {
        const res = await fetch(`${BACKEND}/api/cachedCars`, {
          headers: { "Accept": "application/json" }
        });
        if (!res.ok) throw new Error(`HTTP ${res.status} for ${BACKEND}/api/cachedCars`);
        const data = await res.json();
        arr = Array.isArray(data)
          ? data
          : Array.isArray(data.cars)
          ? data.cars
          : [];
        if (!arr.length) throw new Error("Empty cars array from /api/cachedCars");
        console.log("Loaded cars from backend:", `${BACKEND}/api/cachedCars`, "count:", arr.length);
      } catch (err) {
        console.warn("Backend failed or returned empty list, using demo cars instead", err);
        cars = DEMO_CARS.slice();
        carsById = new Map(cars.map(c => [carId(c), c]));
        return;
      }

      cars = arr
        .map(raw => {
          const brand = raw.brand || raw.make || raw.manufacturer || "";
          const model = raw.model || raw.name || "";
          if (!brand || !model) return null;
          const body = raw.body || raw.bodyStyle || raw.segment || raw["body style"] || "Unknown";
          const fuel = raw.fuel || raw.fuelType || raw.powertrain || "Unknown";
          const gearText = raw.transmission || raw.gear || raw.gearbox || "";
          let gear = "Auto";
          if (gearText) {
            const t = String(gearText).toLowerCase();
            if (t.includes("manual")) gear = "Manual";
            else if (t.includes("auto")) gear = "Auto";
          }
          const price = parsePrice(
            raw.price ??
            raw.priceFromEur ??
            raw.price_from_eur ??
            raw.priceFrom ??
            raw.price_from
          );
          const rating = Number(raw.rating ?? raw.score ?? 4.5);
          const year = Number(raw.year || raw.modelYear || new Date().getFullYear());
          const popularIn = raw.popularIn || ["IT"];
          const img = raw.image || raw.img || raw.thumbnail || raw.pictureUrl || "";
          return { brand, model, year, body, fuel, gear, price, rating, popularIn, img };
        })
        .filter(Boolean);

      carsById = new Map(cars.map(c => [carId(c), c]));
    }

    await loadCarsFromBackend();

    // Toasts
    function showToast(msg) {
      const wrap = document.getElementById("toastWrap");
      if (!wrap) return;
      const el = document.createElement("div");
      el.className = "toast";
      el.textContent = msg;
      wrap.appendChild(el);
      requestAnimationFrame(() => {
        el.classList.add("show");
      });
      setTimeout(() => {
        el.classList.remove("show");
        el.classList.add("hide");
        setTimeout(() => {
          if (wrap.contains(el)) wrap.removeChild(el);
        }, 200);
      }, 1800);
    }

    // Wishlist
    const WISHLIST_KEY = "velovalue_wishlist_v1";
    const wishlist = new Set(
      (() => {
        try {
          return JSON.parse(localStorage.getItem(WISHLIST_KEY) || "[]");
        } catch {
          return [];
        }
      })().filter(id => carsById.has(id))
    );

    function saveWishlist() {
      localStorage.setItem(WISHLIST_KEY, JSON.stringify([...wishlist]));
    }

    function updateWishlistBadge() {
      const b = document.getElementById("wishlistBadge");
      if (!b) return;
      const n = wishlist.size;
      if (n) {
        b.textContent = String(n);
        b.style.display = "grid";
      } else {
        b.textContent = "0";
        b.style.display = "none";
      }
    }

    function buildWishlistMenu() {
      const list = document.getElementById("wishlistItems");
      if (!list) return;
      if (!wishlist.size) {
        list.innerHTML = '<div class="dropdown-empty" style="padding:20px; text-align:center; opacity:.75;">Your wishlist is empty.</div>';
        return;
      }
      list.innerHTML = [...wishlist]
        .map(id => {
          const c = carsById.get(id);
          if (!c) return "";
          const img = c.img || "https://via.placeholder.com/80x50?text=Car";
          return `
            <div class="wish-item" data-id="${id}">
              <img src="${img}" alt="${c.brand} ${c.model}">
              <div class="wish-meta">
                <div class="wish-title">${c.brand} ${c.model}</div>
                <div class="wish-sub">${c.body} • ${toEUR(c.price)}</div>
              </div>
              <button class="remove-btn" data-remove="${id}">Remove</button>
            </div>`;
        })
        .join("");
    }

    function syncHeartButtons() {
      $$(".heart-btn").forEach(btn => {
        const id = btn.dataset.id;
        const active = wishlist.has(id);
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-pressed", active ? "true" : "false");
        btn.setAttribute("aria-label", active ? "Remove from wishlist" : "Add to wishlist");
      });
    }

    function toggleWishlist(id) {
      const c = carsById.get(id);
      if (!c) return;
      const was = wishlist.has(id);
      if (was) {
        wishlist.delete(id);
        showToast(`Removed: ${c.brand} ${c.model}`);
      } else {
        wishlist.add(id);
        showToast(`Added: ${c.brand} ${c.model}`);
      }
      saveWishlist();
      updateWishlistBadge();
      buildWishlistMenu();
      syncHeartButtons();
      const btn = document.querySelector(`.heart-btn[data-id="${id}"]`);
      if (btn) {
        btn.classList.remove("pop");
        void btn.offsetWidth;
        btn.classList.add("pop");
      }
    }

    // Compare state
    const CMP_KEY = "vv_compare_ids";
    const META_KEY = "vv_compare_meta";
    const MAX_CMP = 4;

    function loadCompare() {
      try {
        return new Set(JSON.parse(localStorage.getItem(CMP_KEY) || "[]"));
      } catch {
        return new Set();
      }
    }

    function saveCompare(set) {
      localStorage.setItem(CMP_KEY, JSON.stringify([...set]));
    }

    function loadMeta() {
      try {
        return JSON.parse(localStorage.getItem(META_KEY) || "{}");
      } catch {
        return {};
      }
    }

    function saveMeta(obj) {
      localStorage.setItem(META_KEY, JSON.stringify(obj));
    }

    function addToCompare(id) {
      const set = loadCompare();
      if (set.has(id)) return set;
      if (set.size >= MAX_CMP) {
        alert(`You can compare up to ${MAX_CMP} cars.`);
        return set;
      }
      const car = carsById.get(id);
      if (!car) return set;
      set.add(id);
      const meta = loadMeta();
      meta[id] = {
        brand: car.brand,
        model: car.model,
        body: car.body,
        price: car.price,
        img: car.img || ""
      };
      saveCompare(set);
      saveMeta(meta);
      return set;
    }

    function removeFromCompare(id) {
      const set = loadCompare();
      set.delete(id);
      saveCompare(set);
      const meta = loadMeta();
      delete meta[id];
      saveMeta(meta);
      return set;
    }

    function updateCompareBadge() {
      const badge = document.getElementById("compareBadge");
      if (!badge) return;
      const n = loadCompare().size;
      if (n) {
        badge.textContent = String(n);
        badge.style.display = "grid";
      } else {
        badge.textContent = "0";
        badge.style.display = "none";
      }
    }

    function buildCompareMenu() {
      const listEl = document.getElementById("compareItems");
      if (!listEl) return;
      const ids = [...loadCompare()];
      const meta = loadMeta();
      if (!ids.length) {
        listEl.innerHTML = '<div class="dropdown-empty" style="padding:20px; text-align:center; opacity:.75;">Nothing to compare.</div>';
        return;
      }
      listEl.innerHTML = ids
        .map(id => {
          const m = meta[id] || {};
          const name = `${m.brand || ""} ${m.model || ""}`.trim() || id;
          const img = m.img || "https://via.placeholder.com/64x40?text=Car";
          const sub = [m.body || "", m.price != null ? toEUR(m.price) : ""]
            .filter(Boolean)
            .join(" • ");
          return `
            <div class="wish-item" data-id="${id}">
              <img src="${img}" alt="${name}">
              <div class="wish-meta">
                <div class="wish-title">${name}</div>
                <div class="wish-sub">${sub}</div>
              </div>
              <button class="remove-btn" data-remove="${id}">Remove</button>
            </div>`;
        })
        .join("");
    }

    function updateCompareBar() {
      const bar = document.getElementById("compareBar");
      const chipsEl = document.getElementById("compareChips");
      if (!bar || !chipsEl) return;
      const ids = [...loadCompare()];
      const meta = loadMeta();
      if (!ids.length) {
        chipsEl.innerHTML = "";
        bar.classList.remove("show");
        return;
      }
      chipsEl.innerHTML = ids
        .map(id => {
          const m = meta[id] || {};
          const name = `${m.brand || ""} ${m.model || ""}`.trim() || id;
          return `<span class="chip" data-id="${id}">${name} <button class="x" aria-label="Remove">×</button></span>`;
        })
        .join("");
      bar.classList.toggle("show", ids.length >= 2);
    }

    function syncCompareButtons() {
      const set = loadCompare();
      $$(".compare-btn").forEach(btn => {
        const id = btn.dataset.compare;
        const active = set.has(id);
        btn.classList.toggle("active", active);
        btn.setAttribute("aria-pressed", active ? "true" : "false");
        btn.setAttribute("aria-label", active ? "Remove from compare" : "Add to compare");
      });
      updateCompareBadge();
      buildCompareMenu();
      updateCompareBar();
    }

    // Buttons HTML
    const heartButtonHTML = id => `
      <button class="heart-btn" data-id="${id}" aria-label="Add to wishlist" aria-pressed="false" title="Wishlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.1 8.64l-.1.1-.1-.1c-1.68-1.79-4.53-1.79-6.21 0-1.8 1.92-1.8 5.02 0 6.94L12 22l6.31-6.42c1.8-1.92 1.8-5.02 0-6.94-1.68-1.79-4.53-1.79-6.21 0z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>`;

    const compareButtonHTML = id => `
      <button class="compare-btn" data-compare="${id}" aria-label="Add to compare" aria-pressed="false" title="Compare">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17h6M3 7h10M3 12h14" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
      </button>`;

    function cardHTML(c, variant) {
      const id = carId(c);
      const cls = variant === "popular" ? "car-card compact" : "car-card";
      const img = c.img || "https://via.placeholder.com/320x200?text=Car";
      return `
        <article class="${cls}" data-id="${id}" role="link" tabindex="0" aria-label="${c.brand} ${c.model}">
          ${heartButtonHTML(id)}
          ${compareButtonHTML(id)}
          <img class="thumb" loading="lazy" src="${img}" alt="${c.brand} ${c.model}">
          <div class="meta">
            <div>
              <div class="name">${c.brand} ${c.model}</div>
              <div class="muted" style="font-size:12px">${c.body} • ${toEUR(c.price)}</div>
            </div>
            <div class="pill">★ ${c.rating.toFixed(1)}</div>
          </div>
        </article>`;
    }

    // Filters state
    const selected = {
      brands: new Set(),
      body: new Set(),
      fuel: new Set(),
      gear: new Set(),
      maxPrice: 120000
    };

    const chipMap = {
      body: new Map(),
      fuel: new Map(),
      gear: new Map()
    };
    const brandTileMap = new Map();
    let els = {};

    function buildFilterChipsAndBrandTiles() {
      const bodies = [...new Set(cars.map(c => c.body).filter(Boolean))].sort();
      const fuels = [...new Set(cars.map(c => c.fuel).filter(Boolean))].sort();
      const gears = [...new Set(cars.map(c => c.gear).filter(Boolean))].sort();
      const brands = [...new Set(cars.map(c => c.brand).filter(Boolean))].sort();

      const makeChip = (label, group) => {
        const el = document.createElement("button");
        el.type = "button";
        el.className = "chip";
        el.textContent = label;
        el.dataset.group = group;
        el.dataset.value = label;
        el.addEventListener("click", () => {
          el.classList.toggle("active");
          const set = selected[group];
          if (el.classList.contains("active")) set.add(label);
          else set.delete(label);
        });
        chipMap[group].set(label, el);
        return el;
      };

      bodies.forEach(b => els.bodyChips.appendChild(makeChip(b, "body")));
      fuels.forEach(f => els.fuelChips.appendChild(makeChip(f, "fuel")));
      gears.forEach(g => els.gearChips.appendChild(makeChip(g, "gear")));

      brands.forEach(name => {
        const tile = document.createElement("div");
        tile.className = "brand-tile";
        tile.tabIndex = 0;
        const logo = document.createElement("div");
        logo.className = "brand-logo";
        logo.textContent = name
          .split(" ")
          .map(s => s[0])
          .join("")
          .slice(0, 3)
          .toUpperCase();
        const label = document.createElement("div");
        label.className = "brand-name";
        label.textContent = name;
        tile.append(logo, label);
        const toggle = () => {
          const active = tile.classList.toggle("active");
          if (active) selected.brands.add(name);
          else selected.brands.delete(name);
          applyFiltersNow(false);
        };
        tile.addEventListener("click", toggle);
        tile.addEventListener("keydown", e => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            toggle();
          }
        });
        brandTileMap.set(name, tile);
        els.brandGrid.appendChild(tile);
      });

      const alphaRow = els.alphaRow;
      alphaRow.innerHTML = "";
      const allSpan = document.createElement("span");
      allSpan.className = "alpha active";
      allSpan.textContent = "All";
      allSpan.addEventListener("click", () => {
        $$(".alpha", alphaRow).forEach(a => a.classList.remove("active"));
        allSpan.classList.add("active");
        $$(".brand-tile", els.brandGrid).forEach(t => {
          t.style.display = "flex";
        });
      });
      alphaRow.appendChild(allSpan);

      "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("").forEach(letter => {
        const span = document.createElement("span");
        span.className = "alpha";
        span.textContent = letter;
        span.addEventListener("click", () => {
          $$(".alpha", alphaRow).forEach(a => a.classList.remove("active"));
          span.classList.add("active");
          $$(".brand-tile", els.brandGrid).forEach(t => {
            const name = t.querySelector(".brand-name").textContent || "";
            t.style.display = name.startsWith(letter) ? "flex" : "none";
          });
        });
        alphaRow.appendChild(span);
      });
    }

    function buildPopularSection() {
      const track = document.getElementById("popularTrack");
      if (!track) return;
      const popularCars = cars.filter(c => (c.popularIn || []).includes("IT"));
      if (!popularCars.length) {
        track.innerHTML = '<div class="muted" style="padding:12px 0;">No data yet.</div>';
        return;
      }
      const doubled = popularCars.concat(popularCars);
      track.innerHTML = doubled.map(c => cardHTML(c, "popular")).join("");
    }

    function updateActiveFiltersUI(q) {
      const chips = [];
      if (q) chips.push({ group: "q", value: q, label: `Search: ${q}` });
      if (selected.maxPrice < 120000) chips.push({ group: "price", value: String(selected.maxPrice), label: `≤ ${toEUR(selected.maxPrice)}` });
      selected.brands.forEach(v => chips.push({ group: "brands", value: v, label: `Brand: ${v}` }));
      selected.body.forEach(v => chips.push({ group: "body", value: v, label: v }));
      selected.fuel.forEach(v => chips.push({ group: "fuel", value: v, label: v }));
      selected.gear.forEach(v => chips.push({ group: "gear", value: v, label: v }));
      els.activeFilters.innerHTML = chips
        .map(c => `<span class="af-chip" data-group="${c.group}" data-value="${c.value}">${c.label} <button class="x" aria-label="Remove ${c.label}">×</button></span>`)
        .join("");
    }

    function relevanceScore(c, q) {
      if (!q) return c.rating * 10 + ((c.popularIn || []).includes("IT") ? 4 : 0);
      const hay = `${c.brand} ${c.model} ${c.body}`.toLowerCase();
      const brand = c.brand.toLowerCase();
      const model = c.model.toLowerCase();
      q = q.toLowerCase().trim();
      let s = 0;
      if (`${c.brand} ${c.model}`.toLowerCase() === q) s += 240;
      if (hay.startsWith(q)) s += 140;
      if (brand === q) s += 120;
      if (model === q) s += 110;
      if (hay.includes(q)) s += 90;
      s += c.rating * 8;
      if ((c.popularIn || []).includes("IT")) s += 6;
      return s;
    }

    function renderCards(list) {
      if (!els.grid) return;
      if (!list.length) {
        els.grid.innerHTML = '<div style="padding:30px; text-align:center; opacity:.75">No cars match your filters. Try clearing some filters or increasing the price range.</div>';
        els.resultCount.textContent = "0 results";
        return;
      }
      els.grid.innerHTML = list.map(c => cardHTML(c, "grid")).join("");
      els.resultCount.textContent = `${list.length} result${list.length !== 1 ? "s" : ""}`;
      syncHeartButtons();
      syncCompareButtons();
    }

    function applyFiltersNow(scroll) {
      const q = els.searchInput.value.trim();
      let list = cars.filter(c => c.price <= selected.maxPrice);
      if (selected.brands.size) list = list.filter(c => selected.brands.has(c.brand));
      if (selected.body.size) list = list.filter(c => selected.body.has(c.body));
      if (selected.fuel.size) list = list.filter(c => selected.fuel.has(c.fuel));
      if (selected.gear.size) list = list.filter(c => selected.gear.has(c.gear));
      if (q) {
        const qLower = q.toLowerCase();
        list = list.filter(c => `${c.brand} ${c.model} ${c.body}`.toLowerCase().includes(qLower));
      }

      switch (els.sortSel.value) {
        case "price_asc":
          list.sort((a, b) => a.price - b.price);
          break;
        case "price_desc":
          list.sort((a, b) => b.price - a.price);
          break;
        case "rating_desc":
          list.sort((a, b) => b.rating - a.rating);
          break;
        default:
          list.sort((a, b) => relevanceScore(b, q) - relevanceScore(a, q));
      }

      updateActiveFiltersUI(q);
      renderCards(list);
      if (scroll && els.grid) {
        els.grid.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    // Card interactions
    function openCarById(id) {
      const car = carsById.get(id);
      if (!car) return;
      const msg = `${car.brand} ${car.model}\n${car.body} • ${toEUR(car.price)}\n\nThis is a demo detail view inside the single page.`;
      alert(msg);
    }

    function onHeartClick(e) {
      const btn = e.target.closest(".heart-btn");
      if (!btn) return;
      e.preventDefault();
      toggleWishlist(btn.dataset.id);
    }

    function onCompareClick(e) {
      const btn = e.target.closest(".compare-btn");
      if (!btn) return;
      e.preventDefault();
      const id = btn.dataset.compare;
      const set = loadCompare();
      if (set.has(id)) {
        removeFromCompare(id);
        showToast("Removed from compare");
      } else {
        addToCompare(id);
        showToast("Added to compare");
      }
      syncCompareButtons();
    }

    function onCardActivate(e, root) {
      const isKey = e.type === "keydown";
      if (isKey && e.key !== "Enter" && e.key !== " ") return;
      const target = e.target;
      if (target.closest(".heart-btn") || target.closest(".compare-btn")) return;
      const card = target.closest(".car-card");
      if (!card || !root.contains(card)) return;
      e.preventDefault();
      openCarById(card.dataset.id);
    }

    // Compare modal
    function openCompareModal() {
      const ids = [...loadCompare()];
      if (ids.length < 2) {
        alert("Add at least 2 cars to compare.");
        return;
      }
      const meta = loadMeta();
      const grid = document.getElementById("compareModalGrid");
      const modal = document.getElementById("compareModal");
      if (!grid || !modal) return;
      grid.innerHTML = ids
        .map(id => {
          const m = meta[id] || {};
          const img = m.img || "https://via.placeholder.com/260x160?text=Car";
          const price = m.price != null ? toEUR(m.price) : "";
          const body = m.body || "";
          const name = `${m.brand || ""} ${m.model || ""}`.trim() || id;
          return `
            <div class="compare-card">
              <img class="compare-card-img" src="${img}" alt="${name}">
              <div class="compare-card-title">${name}</div>
              <div class="compare-card-sub">${body}</div>
              <div class="compare-card-price">${price}</div>
            </div>`;
        })
        .join("");
      modal.classList.add("show");
      modal.setAttribute("aria-hidden", "false");
    }

    function closeCompareModal() {
      const modal = document.getElementById("compareModal");
      if (!modal) return;
      modal.classList.remove("show");
      modal.setAttribute("aria-hidden", "true");
    }

    // Dropdown wiring
    function wireWishlistDropdown() {
      const wrap = document.getElementById("wishlist");
      const btn = document.getElementById("wishlistBtn");
      const items = document.getElementById("wishlistItems");
      const clearBtn = document.getElementById("clearWishlist");
      if (!wrap || !btn || !items || !clearBtn) return;

      btn.addEventListener("click", () => {
        const open = wrap.classList.toggle("open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });

      document.addEventListener("click", e => {
        if (!wrap.contains(e.target)) {
          wrap.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
        }
      });

      document.addEventListener("keydown", e => {
        if (e.key === "Escape") {
          wrap.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
        }
      });

      items.addEventListener("click", e => {
        const removeBtn = e.target.closest("[data-remove]");
        if (removeBtn) {
          toggleWishlist(removeBtn.getAttribute("data-remove"));
          return;
        }
        const item = e.target.closest(".wish-item");
        if (item) {
          openCarById(item.getAttribute("data-id"));
        }
      });

      clearBtn.addEventListener("click", () => {
        wishlist.clear();
        saveWishlist();
        updateWishlistBadge();
        buildWishlistMenu();
        syncHeartButtons();
        showToast("Wishlist cleared");
      });
    }

    function wireCompareDropdown() {
      const wrap = document.getElementById("compare");
      const btn = document.getElementById("compareBtn");
      const list = document.getElementById("compareItems");
      const clearBtn = document.getElementById("clearCompare");
      const viewBtn = document.getElementById("viewCompare");
      if (!wrap || !btn || !list || !clearBtn || !viewBtn) return;

      btn.addEventListener("click", () => {
        const open = wrap.classList.toggle("open");
        btn.setAttribute("aria-expanded", open ? "true" : "false");
      });

      document.addEventListener("click", e => {
        if (!wrap.contains(e.target)) {
          wrap.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
        }
      });

      document.addEventListener("keydown", e => {
        if (e.key === "Escape") {
          wrap.classList.remove("open");
          btn.setAttribute("aria-expanded", "false");
        }
      });

      list.addEventListener("click", e => {
        const removeBtn = e.target.closest("[data-remove]");
        if (!removeBtn) return;
        const id = removeBtn.getAttribute("data-remove");
        removeFromCompare(id);
        syncCompareButtons();
      });

      clearBtn.addEventListener("click", () => {
        saveCompare(new Set());
        saveMeta({});
        syncCompareButtons();
      });

      viewBtn.addEventListener("click", openCompareModal);
    }

    function wireHamburgerMenu() {
      const hamburger = document.querySelector(".hamburger");
      const menu = document.getElementById("hamburgerMenu");
      const overlay = document.querySelector(".menu-overlay");
      if (!hamburger || !menu || !overlay) return;

      const openMenu = () => {
        hamburger.setAttribute("aria-expanded", "true");
        hamburger.classList.add("is-active");
        menu.classList.add("active");
        overlay.classList.add("active");
      };

      const closeMenu = () => {
        hamburger.setAttribute("aria-expanded", "false");
        hamburger.classList.remove("is-active");
        menu.classList.remove("active");
        overlay.classList.remove("active");
      };

      const toggleMenu = () => {
        if (menu.classList.contains("active")) closeMenu();
        else openMenu();
      };

      hamburger.addEventListener("click", toggleMenu);
      overlay.addEventListener("click", closeMenu);

      menu.addEventListener("click", e => {
        if (e.target.tagName === "A") closeMenu();
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth > 1024 && menu.classList.contains("active")) closeMenu();
      });
    }

    function wireLanguageSelector() {
      const sel = document.getElementById("languageSelect");
      if (!sel) return;
      sel.addEventListener("change", e => {
        const val = e.target.value || "en";
        document.documentElement.lang = val;
        const label = e.target.selectedOptions[0]?.textContent?.trim() || val;
        showToast(`Language set to ${label}`);
      });
    }

    function clearAllFilters() {
      selected.brands.clear();
      selected.body.clear();
      selected.fuel.clear();
      selected.gear.clear();
      selected.maxPrice = 120000;
      els.searchInput.value = "";
      els.priceRange.value = "120000";
      els.priceOut.textContent = `≤ ${toEUR(selected.maxPrice)}`;
      ["body", "fuel", "gear"].forEach(g => {
        chipMap[g].forEach(el => el.classList.remove("active"));
      });
      brandTileMap.forEach(tile => tile.classList.remove("active"));
      applyFiltersNow(false);
    }

    function handleActiveFilterClick(e) {
      const x = e.target.closest(".x");
      if (!x) return;
      const chip = x.closest(".af-chip");
      if (!chip) return;
      const group = chip.dataset.group;
      const value = chip.dataset.value;
      if (group === "q") {
        els.searchInput.value = "";
      } else if (group === "price") {
        selected.maxPrice = 120000;
        els.priceRange.value = "120000";
        els.priceOut.textContent = `≤ ${toEUR(selected.maxPrice)}`;
      } else if (group === "brands") {
        selected.brands.delete(value);
        const tile = brandTileMap.get(value);
        if (tile) tile.classList.remove("active");
      } else if (selected[group]) {
        selected[group].delete(value);
        const el = chipMap[group].get(value);
        if (el) el.classList.remove("active");
      }
      applyFiltersNow(false);
    }

    function handleCompareChipClick(e) {
      const x = e.target.closest(".x");
      if (!x) return;
      const chip = x.closest(".chip");
      if (!chip) return;
      const id = chip.dataset.id;
      removeFromCompare(id);
      syncCompareButtons();
    }

    function clearAllCompare() {
      saveCompare(new Set());
      saveMeta({});
      syncCompareButtons();
    }

    function initApp() {
      els = {
        bodyChips: document.getElementById("bodyChips"),
        fuelChips: document.getElementById("fuelChips"),
        gearChips: document.getElementById("gearChips"),
        priceRange: document.getElementById("priceRange"),
        priceOut: document.getElementById("priceOut"),
        brandGrid: document.getElementById("brandGrid"),
        alphaRow: document.getElementById("alphaRow"),
        grid: document.getElementById("resultsGrid"),
        resultCount: document.getElementById("resultCount"),
        sortSel: document.getElementById("sortSel"),
        searchInput: document.getElementById("searchInput"),
        searchBtn: document.getElementById("searchBtn"),
        applyBtn: document.getElementById("applyFilters"),
        activeFilters: document.getElementById("activeFilters"),
        clearFiltersBtn: document.getElementById("clearFiltersBtn")
      };

      // Build UI pieces
      buildFilterChipsAndBrandTiles();
      buildPopularSection();

      // Remote search + filters
      async function handleSearchSubmit(scroll) {
        const q = els.searchInput.value.trim();
        const parts = q.split(/\s+/).filter(Boolean);

        // If no query or not "brand model" format, just filter existing list
        if (!q || parts.length < 2) {
          applyFiltersNow(scroll);
          return;
        }

        const brandQuery = parts[0];
        const modelQuery = parts.slice(1).join(" ");

        try {
          // Call the same backend as your working demo page
          const url = `${BACKEND}/api/explore?brand=${encodeURIComponent(brandQuery)}&model=${encodeURIComponent(modelQuery)}`;
          const res = await fetch(url);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          const raw = Array.isArray(data) ? data[0] : data;

          if (raw) {
            const brand = raw.brand || raw.make || raw.manufacturer || "";
            const model = raw.model || raw.name || "";
            if (brand && model) {
              const body = raw.body || raw.bodyStyle || raw.segment || "Unknown";
              const fuel = raw.fuel || raw.fuelType || raw.powertrain || "Electric";
              const gear = raw.gear || raw.transmission || "Auto";
              const price = parsePrice(raw.price ?? raw.priceFromEur ?? raw.price_from_eur);
              const rating = Number(raw.rating ?? 4.5);
              const year = Number(raw.year || new Date().getFullYear());
              const popularIn = raw.popularIn || ["IT"];
              const img = raw.image || raw.img || raw.thumbnail || "";

              const car = { brand, model, year, body, fuel, gear, price, rating, popularIn, img };
              const id = carId(car);

              // Merge into in-memory dataset backing filters/search
              carsById.set(id, car);
              const existingIndex = cars.findIndex(c => carId(c) === id);
              if (existingIndex !== -1) {
                cars[existingIndex] = car;
              } else {
                cars.push(car);
              }
            }
          }
        } catch (err) {
          console.warn("Search backend failed, using local filter only", err);
        }

        // Always run the normal filter / sort pipeline afterwards
        applyFiltersNow(scroll);
      }

      // Filters + search events
      els.applyBtn.addEventListener("click", () => applyFiltersNow(true));
      els.searchBtn.addEventListener("click", () => handleSearchSubmit(true));
      els.searchInput.addEventListener("keydown", e => {
        if (e.key === "Enter") handleSearchSubmit(true);
      });
      els.searchInput.addEventListener("input", debounce(() => applyFiltersNow(false), 280));
      els.sortSel.addEventListener("change", () => applyFiltersNow(false));

      els.priceRange.addEventListener("input", e => {
        selected.maxPrice = Number(e.target.value);
        els.priceOut.textContent = `≤ ${toEUR(selected.maxPrice)}`;
      });

      document.getElementById("filtersToggle").addEventListener("click", () => {
        const left = document.getElementById("leftFilters");
        const collapsed = left.classList.toggle("collapsed");
        document.getElementById("filtersToggle").setAttribute("aria-expanded", collapsed ? "false" : "true");
      });

      els.clearFiltersBtn.addEventListener("click", clearAllFilters);
      els.activeFilters.addEventListener("click", handleActiveFilterClick);

      // Wishlist & compare dropdowns
      wireWishlistDropdown();
      wireCompareDropdown();

      // Sticky compare bar
      document.getElementById("compareChips").addEventListener("click", handleCompareChipClick);
      document.getElementById("compareClearBtn").addEventListener("click", clearAllCompare);
      document.getElementById("compareGoBtn").addEventListener("click", openCompareModal);

      // Compare modal close
      const modal = document.getElementById("compareModal");
      const modalClose = document.getElementById("compareModalClose");
      if (modal && modalClose) {
        modalClose.addEventListener("click", closeCompareModal);
        modal.addEventListener("click", e => {
          if (e.target === modal) closeCompareModal();
        });
      }

      document.addEventListener("keydown", e => {
        if (e.key === "Escape") closeCompareModal();
      });

      // Card click delegates
      const grid = document.getElementById("resultsGrid");
      const track = document.getElementById("popularTrack");
      if (grid) {
        grid.addEventListener("click", onHeartClick);
        grid.addEventListener("click", onCompareClick);
        grid.addEventListener("click", e => onCardActivate(e, grid));
        grid.addEventListener("keydown", e => onCardActivate(e, grid));
      }
      if (track) {
        track.addEventListener("click", onHeartClick);
        track.addEventListener("click", onCompareClick);
        track.addEventListener("click", e => onCardActivate(e, track));
        track.addEventListener("keydown", e => onCardActivate(e, track));
      }

      // Header & language
      wireHamburgerMenu();
      wireLanguageSelector();

      const loginBtn = document.getElementById("loginBtn");
      if (loginBtn) {
        loginBtn.addEventListener("click", () => {
          showToast("Authentication is not implemented in this demo.");
        });
      }

      // Initial render
      updateWishlistBadge();
      buildWishlistMenu();
      applyFiltersNow(false);
      syncHeartButtons();
      syncCompareButtons();

      const yearSpan = document.getElementById("yearSpan");
      if (yearSpan) yearSpan.textContent = new Date().getFullYear();
    }

    document.addEventListener("DOMContentLoaded", initApp);
  </script>
</body>
</html>